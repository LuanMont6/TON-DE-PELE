rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /products/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.isAdmin == false;
      allow update: if request.auth != null
                    && ((request.auth.uid == uid
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])
                         && request.resource.data.keys().hasOnly(['name','email','phone','wishlist','isAdmin'])
                         && (!('wishlist' in request.resource.data) || request.resource.data.wishlist.size() <= 200))
                        || isAdmin());
      allow delete: if false;
    }

    // orders — anyone can place; only admin reads/updates/deletes
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','phone','address','payment','items','total','status'])
                    && request.resource.data.name    is string && request.resource.data.name.size()    <= 120
                    && request.resource.data.phone   is string && request.resource.data.phone.size()   <= 30
                    && request.resource.data.address is string && request.resource.data.address.size() <= 300
                    && request.resource.data.payment is string && request.resource.data.payment.size() <= 60
                    && request.resource.data.items   is list
                    && request.resource.data.items.size() >= 1
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total   is number
                    && request.resource.data.status  == 'novo';
      allow read, update, delete: if isAdmin();
    }

    // coupons — public read needed for unauthenticated coupon validation; admin manages
    match /coupons/{code} {
      allow read:  if true;
      allow write: if isAdmin();
    }

  }
}
